---
const year = new Date().getFullYear();
---

<footer class="footer">
  <hr class="footer__rule" />

  <div class="footer__meta">
    <span class="footer__copy">© {year} CLOUT</span>
    <span class="footer__tagline">Insights. Strategy. Impact.</span>
  </div>

  <p class="footer__wordmark" aria-hidden="true">CLOUT</p>
</footer>

<style>
  .footer {
    background: #FAFAF7;
    padding: 2.5rem 3rem 0;
    overflow: hidden;
  }

  .footer__rule {
    border: none;
    border-top: 1px solid #DADADA;
    margin: 0 0 2rem;
  }

  .footer__meta {
    max-width: 1280px;
    margin: 0 auto 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer__copy {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #BBBBBB;
  }

  .footer__tagline {
    font-family: "Neue Montreal", var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #BBBBBB;
  }

  .footer__wordmark {
    font-family: var(--font-sans);
    font-size: clamp(8rem, 20vw, 22rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: #111111;
    text-align: left;
    width: 100%;
    overflow: hidden;
    margin: 0;
    padding: 0;
    display: block;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 2rem 1.5rem 0;
    }
  }
</style>
