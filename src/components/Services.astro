---
const services = [
  { number: "01", name: "Strategy", desc: "We translate data and cultural signals into clear brand strategy. No guesswork, just direction that sticks." },
  { number: "02", name: "Communications", desc: "From campaign concepts to content strategy, we build communications that land with the right audience at the right moment." },
  { number: "03", name: "Audience Intelligence", desc: "We analyze who your audience really is, what drives their behavior, and what keeps their attention." },
  { number: "04", name: "Cultural Insights", desc: "We track cultural shifts before they become trends, so your brand stays relevant instead of catching up." },
];
---

<section class="services" id="services">
  <div class="services__inner">

    <div class="services__left">
      <span class="services__label">What we do</span>
      <p class="services__intro" set:html={`CLOUT is a Creative Intelligence Studio. We research audiences, analyse <span class="highlight">behavioural data</span> and track what’s moving in the world to help brands make <span class="highlight">smarter decisions.</span>`}></p>
      <p class="services__intro services__intro--gap" set:html={`Whether you need a sharper strategy, a stronger communications approach or a deeper understanding of your audience, we turn <span class="highlight">data and insight</span> into work that actually makes an impact.`}></p>
    </div>

    <ul class="services__list">
      {services.map((s) => (
        <li class="service-row">
          <button class="service-row__header" aria-expanded="false">
            <span class="service-row__num">{s.number}</span>
            <span class="service-row__name">{s.name}</span>
            <span class="service-row__toggle" aria-hidden="true">+</span>
          </button>
          <div class="service-row__body">
            <p class="service-row__desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .services {
    background: #FAFAF7;
    padding: 7.5rem 3rem;
    border-top: 1px solid #DADADA;
  }

  .services__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: 80px;
    align-items: start;
  }

  .services__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999999;
    margin-bottom: 1.5rem;
  }

  .services__intro {
    font-family: "Neue Montreal", var(--font-sans);
    font-weight: 400;
    font-size: 1.05rem;
    color: #555555;
    line-height: 1.7;
  }

  .services__intro--gap {
    margin-top: 1rem;
  }

  .highlight {
    color: #6B5FD4;
    text-decoration: none;
    font-weight: 500;
    cursor: default;
  }

  .services__list {
    list-style: none;
    border-top: 1px solid rgba(203, 190, 255, 0.35);
  }

  .service-row {
    border-bottom: 1px solid rgba(203, 190, 255, 0.35);
    opacity: 0;
    transform: translateX(-48px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-row.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .service-row:nth-child(1) { transition-delay: 0ms; }
  .service-row:nth-child(2) { transition-delay: 100ms; }
  .service-row:nth-child(3) { transition-delay: 200ms; }
  .service-row:nth-child(4) { transition-delay: 300ms; }

  /* Clickable header row */
  .service-row__header {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.1rem 0;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    overflow: hidden;
    transition: padding-left 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-row__header::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--lavender);
    transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1;
  }

  .service-row__header::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--lavender);
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-row__header:hover::before {
    width: 100%;
  }

  .service-row__header:hover::after {
    height: 100%;
  }

  .service-row__header:hover {
    padding-left: 1.25rem;
  }

  .service-row__num {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--charcoal);
    opacity: 0.3;
    min-width: 2rem;
    flex-shrink: 0;
    transition: opacity 0.3s ease;
  }

  .service-row__header:hover .service-row__num {
    opacity: 0.7;
  }

  .service-row__name {
    font-family: var(--font-sans);
    font-size: 3.5vw;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--charcoal);
    flex: 1;
    transition: color 0.3s ease;
  }

  .service-row__header:hover .service-row__name {
    color: rgba(17, 17, 17, 0.75);
  }

  .service-row__toggle {
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--charcoal);
    opacity: 0.35;
    flex-shrink: 0;
    line-height: 1;
    transition: transform 0.4s ease, opacity 0.3s ease;
  }

  .service-row__header:hover .service-row__toggle {
    opacity: 0.6;
  }

  .service-row.is-open .service-row__toggle {
    transform: rotate(45deg);
    opacity: 0.7;
  }

  /* Accordion body */
  .service-row__body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .service-row__desc {
    font-family: "Neue Montreal", var(--font-sans);
    font-weight: 400;
    font-size: 15px;
    color: #555555;
    line-height: 1.7;
    padding: 1rem 2rem 1.75rem 4.5rem;
    max-width: 600px;
  }

  @media (max-width: 900px) {
    .services {
      padding: 5rem 1.5rem 7rem;
    }
    .services__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .service-row__header {
      gap: 1.5rem;
      padding: 1rem 0;
    }
    .service-row__header:hover {
      padding-left: 0.5rem;
    }
    .service-row__name {
      font-size: 6vw;
    }
    .service-row__toggle {
      font-size: 1.2rem;
    }
    .service-row__desc {
      padding-left: 2rem;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".service-row");
  const headers = document.querySelectorAll<HTMLElement>(".service-row__header");

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  rows.forEach((row) => io.observe(row));

  headers.forEach((header) => {
    header.addEventListener("click", () => {
      const row = header.closest<HTMLElement>(".service-row")!;
      const body = row.querySelector<HTMLElement>(".service-row__body")!;
      const isOpen = row.classList.contains("is-open");

      // Close all
      rows.forEach((r) => {
        r.classList.remove("is-open");
        r.querySelector<HTMLElement>(".service-row__body")!.style.maxHeight = "0";
        r.querySelector<HTMLElement>(".service-row__header")!.setAttribute("aria-expanded", "false");
      });

      // Open clicked row if it was closed
      if (!isOpen) {
        row.classList.add("is-open");
        body.style.maxHeight = body.scrollHeight + "px";
        header.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
