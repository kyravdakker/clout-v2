---
---

<section class="hero" id="hero">
  <div id="hero-clout">
    <h1 class="hero__wordmark" aria-label="CLOUT">CLOUT</h1>
    <p class="hero__tagline">Insights. Strategy. Impact.</p>
    <div class="hero__scroll-hint" aria-hidden="true">
      <span class="hero__scroll-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 150vh;
    overflow: hidden;
    background: var(--cloud-white);
  }

  #hero-clout {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hero__wordmark {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 18vw;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 0.9;
    color: var(--charcoal);
    white-space: nowrap;
    opacity: 1;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    font-weight: 500;
    font-style: italic;
    color: var(--charcoal);
    opacity: 0;
    margin-top: 2rem;
    letter-spacing: 0.01em;
    animation: taglineFade 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    will-change: opacity;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: taglineFade 1s ease 1.4s forwards;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, rgba(17, 17, 17, 0.2));
    animation: scrollPulse 2.2s ease-in-out 2s infinite;
  }

  @keyframes taglineFade {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.35; }
    50%       { opacity: 0.8; }
  }

  @media (max-width: 640px) {
    .hero__wordmark {
      font-size: 22vw;
    }
    .hero__tagline {
      font-size: clamp(1rem, 4vw, 1.4rem);
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  const wordmark = document.querySelector<HTMLElement>(".hero__wordmark");
  const tagline  = document.querySelector<HTMLElement>(".hero__tagline");

  if (wordmark && tagline) {
    let ticking = false;

    const update = () => {
      const progress = Math.min(1, window.scrollY / (window.innerHeight * 2));

      tagline.style.opacity = String(Math.max(0, 1 - progress * 4));

      const scale     = 1 + progress * 5;
      const translateY = progress * -15 + "vh";
      const opacity   = progress < 0.5 ? 1 : Math.max(0, 1 - (progress - 0.5) * 2);

      wordmark.style.transform = `translateY(${translateY}) scale(${scale})`;
      wordmark.style.opacity   = String(opacity);

      ticking = false;
    };

    update();

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
