---

<section class="hero" id="hero">
  <div id="hero-clout">
    <p class="hero__side-text">We help brands understand what drives <span style="color: #6B5FD4; font-weight: 700;">attention</span>.</p>
    <h1 class="hero__wordmark" aria-label="CLOUT">CLOUT</h1>
    <div class="hero__scroll-hint" aria-hidden="true">
      <span class="hero__scroll-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    height: calc(100vh + 4.75rem);
    overflow: hidden;
    background: var(--cloud-white);
  }

  #hero-clout {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hero__wordmark {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 18vw;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 0.9;
    color: var(--charcoal);
    white-space: nowrap;
    opacity: 1;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .hero__side-text {
    position: absolute;
    left: 5%;
    top: 50%;
    transform: translateY(calc(-50% + 8vw));
    font-family: "Neue Montreal", var(--font-sans);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: #111111;
    opacity: 0.6;
    line-height: 1.5;
    max-width: 160px;
    pointer-events: none;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: taglineFade 1s ease 1.4s forwards;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, rgba(17, 17, 17, 0.2));
    animation: scrollPulse 2.2s ease-in-out 2s infinite;
  }

  @keyframes taglineFade {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.35; }
    50%       { opacity: 0.8; }
  }

  @media (max-width: 640px) {
    .hero__wordmark {
      font-size: 22vw;
    }
    .hero__side-text {
      display: none;
    }
  }
</style>

<script>
  const wordmark = document.querySelector<HTMLElement>(".hero__wordmark");

  if (wordmark) {
    let ticking = false;

    const update = () => {
      const progress = Math.min(1, window.scrollY / (window.innerHeight * 2));

      const scale     = 1 + progress * 5;
      const translateY = progress * -15 + "vh";
      const opacity   = progress < 0.5 ? 1 : Math.max(0, 1 - (progress - 0.5) * 2);

      wordmark.style.transform = `translateY(${translateY}) scale(${scale})`;
      wordmark.style.opacity   = String(opacity);

      ticking = false;
    };

    update();

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
