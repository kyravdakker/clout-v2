<section class="contact" id="contact">
  <div class="contact__inner">

    <div class="contact__left">
      <span class="contact__label">Get in touch</span>
      <h2 class="contact__heading">
        Let's build<br />something that matters.
      </h2>
      <p class="contact__location">Amsterdam, NL // Working globally</p>
    </div>

    <div class="contact__right">
      <a href="mailto:hello@clout.studio" class="contact__email">
        hello@clout.studio
      </a>
    </div>

  </div>
</section>

<style>
  .contact {
    background: #FAFAF7;
    color: var(--charcoal);
    padding: 7.5rem 3rem 6rem;
    border-top: 1px solid #DADADA;
  }

  .contact__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .contact__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999999;
    margin-bottom: 1.5rem;
  }

  .contact__heading {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--charcoal);
    margin-bottom: 2rem;
  }

  .contact__location {
    font-family: "Neue Montreal", var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #DADADA;
  }

  .contact__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .contact__email {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #111111;
    text-decoration: underline;
    text-decoration-color: rgba(17, 17, 17, 0.25);
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1.5px;
    transition: color 0.25s ease, text-decoration-color 0.25s ease;
    white-space: nowrap;
  }

  .contact__email:hover {
    color: #6B5FD4;
    text-decoration-color: #6B5FD4;
  }

  @media (max-width: 900px) {
    .contact {
      padding: 5rem 1.5rem 4rem;
    }
    .contact__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .contact__right {
      justify-content: flex-start;
    }
    .contact__email {
      white-space: normal;
    }
  }
</style>
