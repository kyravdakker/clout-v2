<section class="about" id="about">
  <div class="about__inner">
    <span class="about__label">Our approach</span>
    <blockquote class="about__quote">
      We study attention<br />before we build strategy.
    </blockquote>
    <p class="about__sub">
      CLOUT sits at the intersection of data and instinct. We read the numbers
      and the room — and we find the insight that changes the brief.
    </p>
  </div>
</section>

<style>
  .about {
    background: #111111;
    padding: 12rem 8vw;
    margin: 0;
  }

  .about__inner {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  .about__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(203, 190, 255, 0.5);
    margin-bottom: 2.5rem;
  }

  .about__quote {
    font-family: "Neue Montreal", var(--font-sans);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    text-indent: 15vw;
    font-weight: 800;
    font-style: normal;
    line-height: 1.1;
    color: #CBBEFF;
    letter-spacing: -0.01em;
    border: none;
    padding: 0;
    margin: 0 0 3.5rem;
    max-width: 900px;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about__quote.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .about__sub {
    font-family: "Neue Montreal", var(--font-sans);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    font-weight: 400;
    line-height: 1.85;
    color: rgba(250, 250, 247, 0.6);
    max-width: 55ch;
  }

  @media (max-width: 900px) {
    .about {
      padding: 7rem 6vw;
    }
  }
</style>

<script>
  const quote = document.querySelector<HTMLElement>(".about__quote");
  if (quote) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          quote.classList.add("is-visible");
          io.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    io.observe(quote);
  }
</script>
